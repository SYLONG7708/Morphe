{
  "schema": 1,
  "repository": "SYLONG7708/Morphe",
  "channel": "stable",
  "check_interval": "PT1H",
  "sources": {
    "distribution": "SYLONG7708/Morphe",
    "upstream_patches": "MorpheApp/morphe-patches",
    "upstream_microg": "MorpheApp/MicroG-RE"
  },
  "uis7870_safe_profile": {
    "vendor_group": "com.sylong.autopatch",
    "patched_youtube_package": "com.sylong.autopatch.android.youtube",
    "microg_package": "com.sylong.autopatch.android.gms",
    "preserve_factory_packages": true
  },
  "youtube": {
    "download_original_apk": false,
    "source_priority": ["installed_compatible", "saved_compatible"],
    "patch_on_device": true
  },
  "install": {
    "silent_when": ["shizuku_authorized", "root_authorized"],
    "system_confirmation_without_privilege": true
  },
  "security": {
    "manifest_signature": "SHA256withRSA",
    "anti_rollback": true,
    "require_https": true,
    "verify_sha256": true,
    "verify_package_and_signer": true
  }
}
