* text=auto

# Ensure the Gradle wrapper uses LF endings so CI can execute it
gradlew text eol=lf

# Root module shell scripts run on Android and must use LF endings
app/src/main/assets/root/*.sh text eol=lf

# Keep Windows batch wrappers with CRLF endings
*.bat text eol=crlf

# Public Maven metadata is hashed and must have identical bytes on every runner.
vendor/m2/**/*.pom text eol=lf
vendor/m2/**/*.module text eol=lf

# Reviewed unified patches are hashed; blank context lines intentionally contain a space.
config/upstream-resolutions/*.patch text eol=lf whitespace=-blank-at-eol
