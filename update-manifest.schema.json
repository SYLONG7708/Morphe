{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SYLONG7708/Morphe/update-manifest.schema.json",
  "title": "SyMorphe signed update manifest",
  "type": "object",
  "required": ["schema", "sequence", "channel", "published_at", "manager", "patches", "microg"],
  "properties": {
    "schema": { "const": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "channel": { "const": "stable" },
    "published_at": { "type": "string", "format": "date-time" },
    "manager": { "$ref": "#/$defs/component" },
    "patches": { "$ref": "#/$defs/component" },
    "microg": { "$ref": "#/$defs/component" }
  },
  "additionalProperties": false,
  "$defs": {
    "component": {
      "type": "object",
      "required": ["version", "artifacts"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "version_code": { "type": "integer", "minimum": 0 },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["name", "url", "sha256", "size"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "size": { "type": "integer", "minimum": 1 },
        "signature_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "package_name": { "type": "string" },
        "version_name": { "type": "string" },
        "version_code": { "type": "integer", "minimum": 0 },
        "min_sdk": { "type": "integer", "minimum": 1 },
        "max_sdk": { "type": "integer", "minimum": 1 },
        "abis": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "signer_sha256": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
